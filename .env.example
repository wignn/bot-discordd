POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=forex
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id

# Lavalink
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

# News WebSocket
NEWS_WS_URL=ws://news-api:8000

# Optional Services
TIINGO_API_KEY=your_tiingo_api_key
YOUTUBE_API_KEY=your_youtube_api_key
API_KEY=your_gemini_api_key

# App Config
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/forex
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Logging
LOG_LEVEL=INFO

# Infoway Market Data (optional, for crypto/stocks)
INFOWAY_API_KEY=your_infoway_api_key
INFOWAY_FOREX_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
INFOWAY_CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT

# MT5Docker Market Data (forex prices from MetaTrader 5)
MT5_WS_URL=ws://mt5docker:8765
MT5_SYMBOLS=XAUUSDm
MT5_SYMBOL_MAP=XAUUSDm:XAUUSD

RSSHUB_URL=http://rsshub:1200
X_USERNAMES=username1,username2,username3
X_POLL_SEC=60
